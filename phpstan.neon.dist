parameters:
    level: 8
    # Gegen die gesamte unterstützte PHP-Spanne (composer: >=8.0 <8.6) analysieren,
    # damit versionsabhängige Signaturen unabhängig von der lokal laufenden
    # PHP-Version erkannt werden.
    phpVersion:
        min: 80000
        max: 80599
    paths:
        - src
    tmpDir: var/phpstan
    reportUnmatchedIgnoredErrors: true
